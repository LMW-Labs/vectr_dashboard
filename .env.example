# Base URL of the backend API
# Example: REACT_APP_API_BASE_URL=https://api.yourdomain.com
REACT_APP_API_BASE_URL=

# Firebase web config (client-side identifiers, not secrets)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Local development only. In deployed environments these come from Google Secret
# Manager via secret_manager.py, declared as managedSecrets in apphosting.yaml.
GEMINI_API_KEY=
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
SENDGRID_API_KEY=
TWITTER_BEARER_TOKEN=